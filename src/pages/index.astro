---
import Layout from "../layouts/Layout.astro";
import site from "../../data/site.json";
import home from "../../data/homepage.json";
import { editableText, editableImage, homepageProp } from "../utils/homepage-editing";

const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
const improvements = home.outcomes.items;
const services = home.services.items;
const process = home.process.steps;
const principles = home.why.principles;

const siteUrl = Astro.site!.href;
const organizationId = new URL("#organization", siteUrl).href;
const structuredData = [
  {
    "@type": "Organization",
    "@id": organizationId,
    name: site.site_title,
    url: siteUrl,
    description: site.description,
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Website design and management services",
      itemListElement: services.map((service) => ({
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: service.title,
          description: service.text,
          url: new URL("#services", siteUrl).href,
          provider: { "@id": organizationId },
        },
      })),
    },
  },
  {
    "@type": "WebSite",
    "@id": new URL("#website", siteUrl).href,
    name: site.site_title,
    url: siteUrl,
    inLanguage: "en-US",
    publisher: { "@id": organizationId },
  },
];
---

<Layout
  title={home.title}
  structuredData={structuredData}
  seo={{
    page_description: home.seo.page_description,
    featured_image: null,
    featured_image_alt: null,
    canonical_url: null,
    no_index: false,
    open_graph_type: "website",
    author_twitter_handle: null,
  }}
>
  <div>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p {...editableText("hero.eyebrow")} class="eyebrow">{home.hero.eyebrow}</p>
        <h1 id="hero-heading"><editable-text data-prop={homepageProp("hero.heading_start")} data-type="span">{home.hero.heading_start}</editable-text> <em {...editableText("hero.heading_highlight")}>{home.hero.heading_highlight}</em> <editable-text data-prop={homepageProp("hero.heading_end")} data-type="span">{home.hero.heading_end}</editable-text></h1>
        <div class="hero-intro">
          <p {...editableText("hero.description")}>
            {home.hero.description}
          </p>
          <a class="button button-primary" href={home.hero.button_link}>
            <editable-text data-prop={homepageProp("hero.button_text")} data-type="span">{home.hero.button_text}</editable-text>
            <span aria-hidden="true">↗</span>
          </a>
          <p {...editableText("hero.note")} class="microcopy">
            {home.hero.note}
          </p>
        </div>
      </div>
      <div class="project-tile hero-project-tile">
        <button
          class="hero-visual device-card mobile-showcase"
          type="button"
          data-open-project
          data-project-view="mobile"
          aria-label={`View the full ${home.work.project_name} mobile design`}
        >
          <span class="mini-phone" aria-hidden="true">
            <span class="mini-phone-speaker"></span>
            <span class="mini-phone-screen">
              <img {...editableImage("images.mobile")}
                src={home.images.mobile.image}
                alt=""
                width={home.images.mobile.width}
                height={home.images.mobile.height}
                fetchpriority="high"
                decoding="async"
              />
            </span>
          </span>
        </button>
        <div class="project-tile-caption">
          <div>
            <span {...editableText("work.mobile_caption")}>{home.work.mobile_caption}</span>
            <strong {...editableText("work.project_name")}>{home.work.project_name}</strong>
          </div>
          <button type="button" data-open-project data-project-view="mobile">
            <editable-text data-prop={homepageProp("work.view_project_text")} data-type="span">{home.work.view_project_text}</editable-text> <span aria-hidden="true">↗</span>
          </button>
        </div>
      </div>
    </div>
    <div class="shell value-rail" aria-label="Core website outcomes">
      <span {...editableText("hero.outcome_trust")}>{home.hero.outcome_trust}</span>
      <span {...editableText("hero.outcome_clarity")}>{home.hero.outcome_clarity}</span>
      <span {...editableText("hero.outcome_conversion")}>{home.hero.outcome_conversion}</span>
      <span {...editableText("hero.outcome_performance")}>{home.hero.outcome_performance}</span>
    </div>
  </section>

  <section class="section problem" id="approach" aria-labelledby="problem-heading">
    <div class="shell">
      <div class="section-heading split-heading">
        <p {...editableText("problem.eyebrow")} class="eyebrow">{home.problem.eyebrow}</p>
        <h2 {...editableText("problem.heading")} id="problem-heading">{home.problem.heading}</h2>
      </div>
      <div class="problem-grid">
        <div class="problem-copy">
          <p {...editableText("problem.introduction")}>
            {home.problem.introduction}
          </p>
          <p {...editableText("problem.description")}>
            {home.problem.description}
          </p>
        </div>
        <div class="question-panel">
          <p {...editableText("problem.questions_heading")} class="panel-kicker">{home.problem.questions_heading}</p>
          <ul>
            <li><span>01</span> <editable-text data-prop={homepageProp("problem.question_services")} data-type="span">{home.problem.question_services}</editable-text></li>
            <li><span>02</span> <editable-text data-prop={homepageProp("problem.question_area")} data-type="span">{home.problem.question_area}</editable-text></li>
            <li><span>03</span> <editable-text data-prop={homepageProp("problem.question_trust")} data-type="span">{home.problem.question_trust}</editable-text></li>
            <li><span>04</span> <editable-text data-prop={homepageProp("problem.question_estimate")} data-type="span">{home.problem.question_estimate}</editable-text></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section outcomes" id="outcomes" aria-labelledby="outcomes-heading">
    <div class="shell">
      <div class="section-heading compact-heading">
        <p {...editableText("outcomes.eyebrow")} class="eyebrow">{home.outcomes.eyebrow}</p>
        <h2 {...editableText("outcomes.heading")} id="outcomes-heading">{home.outcomes.heading}</h2>
      </div>
      <div class="outcome-grid">
        {improvements.map((item, index) => (
          <article class="outcome-card">
            <span class="card-number">/<editable-text data-prop={homepageProp(`outcomes.items.${index}.number`)} data-type="span">{item.number}</editable-text></span>
            <h3 {...editableText(`outcomes.items.${index}.title`)}>{item.title}</h3>
            <p {...editableText(`outcomes.items.${index}.text`)}>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section recent-work" id="work" aria-labelledby="work-heading">
    <div class="shell">
      <div class="work-heading">
        <p {...editableText("work.eyebrow")} class="eyebrow">{home.work.eyebrow}</p>
        <h2 {...editableText("work.heading")} id="work-heading">{home.work.heading}</h2>
        <p {...editableText("work.description")}>
          {home.work.description}
        </p>
      </div>

      <article class="project-feature" aria-labelledby="energy-project-title">
        <header class="project-feature-header">
          <div>
            <p {...editableText("work.project_label")} class="project-number">{home.work.project_label}</p>
            <h3 {...editableText("work.project_name")} id="energy-project-title">{home.work.project_name}</h3>
          </div>
          <ul class="project-services" aria-label="Project services">
            <li {...editableText("work.service_strategy")}>{home.work.service_strategy}</li>
            <li {...editableText("work.service_design")}>{home.work.service_design}</li>
            <li {...editableText("work.service_development")}>{home.work.service_development}</li>
          </ul>
        </header>

        <div class="device-switch" role="group" aria-label="Choose a design preview">
          <button class="is-active" type="button" data-preview-choice="desktop" aria-pressed="true">
            <editable-text data-prop={homepageProp("work.desktop_label")} data-type="span">{home.work.desktop_label}</editable-text>
          </button>
          <button type="button" data-preview-choice="mobile" aria-pressed="false">
            <editable-text data-prop={homepageProp("work.mobile_label")} data-type="span">{home.work.mobile_label}</editable-text>
          </button>
        </div>

        <div class="project-stage">
          <div class="browser-frame project-device is-active" data-project-preview="desktop">
            <div class="browser-bar" aria-hidden="true">
              <span class="browser-dots"><i></i><i></i><i></i></span>
              <span {...editableText("work.display_domain")} class="browser-address">{home.work.display_domain}</span>
            </div>
            <div class="browser-viewport">
              <img {...editableImage("images.desktop", "alt")}
                src={home.images.desktop.image}
                alt={home.images.desktop.alt}
                width={home.images.desktop.width}
                height={home.images.desktop.height}
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>

          <div class="phone-frame project-device" data-project-preview="mobile">
            <div class="phone-speaker" aria-hidden="true"></div>
            <div class="phone-viewport">
              <img {...editableImage("images.mobile", "alt")}
                src={home.images.mobile.image}
                alt={home.images.mobile.alt}
                width={home.images.mobile.width}
                height={home.images.mobile.height}
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>

        <footer class="project-feature-footer">
          <p {...editableText("work.note")}>
            {home.work.note}
          </p>
          <button class="project-view-button" type="button" data-open-project>
            <editable-text data-prop={homepageProp("work.view_full_text")} data-type="span">{home.work.view_full_text}</editable-text> <span aria-hidden="true">↗</span>
          </button>
        </footer>
      </article>
    </div>
  </section>

  <dialog class="project-dialog" id="energy-project-dialog" aria-labelledby="project-dialog-title">
    <div class="project-dialog-inner">
      <header class="project-dialog-header">
        <div>
          <span {...editableText("work.project_label")} class="project-number">{home.work.project_label}</span>
          <h2 {...editableText("work.project_name")} id="project-dialog-title">{home.work.project_name}</h2>
        </div>
        <div class="dialog-actions">
          <div class="dialog-switch" role="group" aria-label="Choose a full design view">
            <button class="is-active" type="button" data-dialog-choice="desktop" aria-pressed="true"><editable-text data-prop={homepageProp("work.desktop_label")} data-type="span">{home.work.desktop_label}</editable-text></button>
            <button type="button" data-dialog-choice="mobile" aria-pressed="false"><editable-text data-prop={homepageProp("work.mobile_label")} data-type="span">{home.work.mobile_label}</editable-text></button>
          </div>
          <button class="dialog-close" type="button" data-close-project aria-label="Close full design viewer">×</button>
        </div>
      </header>
      <div class="project-dialog-scroll">
        <div class="dialog-design is-active" data-dialog-design="desktop">
          <img {...editableImage("images.desktop", "full_alt")}
            src={home.images.desktop.image}
            alt={home.images.desktop.full_alt}
            width={home.images.desktop.width}
            height={home.images.desktop.height}
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="dialog-design" data-dialog-design="mobile">
          <img {...editableImage("images.mobile", "full_alt")}
            src={home.images.mobile.image}
            alt={home.images.mobile.full_alt}
            width={home.images.mobile.width}
            height={home.images.mobile.height}
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </dialog>

  {home.testimonial.quote.trim() && home.testimonial.client_name.trim() && (
  <section class="section testimonials" aria-labelledby="testimonials-heading">
    <div class="shell testimonial-grid">
      <div class="testimonial-heading">
        <p {...editableText("testimonial.eyebrow")} class="eyebrow eyebrow-light">{home.testimonial.eyebrow}</p>
        <h2 {...editableText("testimonial.heading")} id="testimonials-heading">{home.testimonial.heading}</h2>
      </div>
      <figure class="testimonial-card">
        <blockquote {...editableText("testimonial.quote")}>{home.testimonial.quote}</blockquote>
        <figcaption>
          <strong {...editableText("testimonial.client_name")}>{home.testimonial.client_name}</strong>
          <span {...editableText("testimonial.client_role")}>{home.testimonial.client_role}</span>
        </figcaption>
      </figure>
    </div>
  </section>
  )}

  <section class="section services" id="services" aria-labelledby="services-heading">
    <div class="shell services-grid">
      <div class="services-sticky">
        <p {...editableText("services.eyebrow")} class="eyebrow">{home.services.eyebrow}</p>
        <h2 {...editableText("services.heading")} id="services-heading">{home.services.heading}</h2>
        <div class="project-tile services-project-tile">
          <button
            class="services-visual device-card desktop-showcase"
            type="button"
            data-open-project
            data-project-view="desktop"
            aria-label={`View the full ${home.work.project_name} desktop design`}
          >
            <span class="mini-browser" aria-hidden="true">
              <span class="mini-browser-bar">
                <span class="mini-browser-dots"><i></i><i></i><i></i></span>
                <span {...editableText("work.display_domain")} class="mini-browser-address">{home.work.display_domain}</span>
              </span>
              <span class="mini-browser-screen">
                <img {...editableImage("images.desktop")}
                  src={home.images.desktop.image}
                  alt=""
                  width={home.images.desktop.width}
                  height={home.images.desktop.height}
                  loading="lazy"
                  decoding="async"
                />
              </span>
            </span>
          </button>
          <div class="project-tile-caption">
            <div>
              <span {...editableText("work.desktop_caption")}>{home.work.desktop_caption}</span>
              <strong {...editableText("work.project_name")}>{home.work.project_name}</strong>
            </div>
            <button type="button" data-open-project data-project-view="desktop">
              <editable-text data-prop={homepageProp("work.view_project_text")} data-type="span">{home.work.view_project_text}</editable-text> <span aria-hidden="true">↗</span>
            </button>
          </div>
        </div>
      </div>
      <div class="service-list">
        {services.map((item, index) => (
          <article class="service-item">
            <span class="service-number">0{index + 1}</span>
            <div>
              <h3 {...editableText(`services.items.${index}.title`)}>{item.title}</h3>
              <p {...editableText(`services.items.${index}.text`)}>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section process" id="process" aria-labelledby="process-heading">
    <div class="shell">
      <div class="section-heading split-heading process-heading">
        <p {...editableText("process.eyebrow")} class="eyebrow eyebrow-light">{home.process.eyebrow}</p>
        <h2 {...editableText("process.heading")} id="process-heading">{home.process.heading}</h2>
      </div>
      <div class="process-list">
        {process.map((item, index) => (
          <article class="process-row">
            <span class="process-number">0{index + 1}</span>
            <h3 {...editableText(`process.steps.${index}.title`)}>{item.title}</h3>
            <p {...editableText(`process.steps.${index}.text`)}>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section why" id="why" aria-labelledby="why-heading">
    <div class="shell why-grid">
      <div class="why-copy">
        <p {...editableText("why.eyebrow")} class="eyebrow">{home.why.eyebrow}</p>
        <h2 {...editableText("why.heading")} id="why-heading">{home.why.heading}</h2>
        <p {...editableText("why.introduction")} class="lead">
          {home.why.introduction}
        </p>
        <p {...editableText("why.description")}>
          {home.why.description}
        </p>
      </div>
      <div class="principles-panel">
        <p {...editableText("why.principles_heading")} class="panel-kicker">{home.why.principles_heading}</p>
        <ul>
          {principles.map((principle, index) => (
            <li><span aria-hidden="true">↳</span><editable-text data-prop={homepageProp(`why.principles.${index}`)} data-type="span">{principle}</editable-text></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="review" id="review" aria-labelledby="review-heading">
    <div class="shell review-grid">
      <div class="review-copy">
        <p {...editableText("review.eyebrow")} class="eyebrow eyebrow-light">{home.review.eyebrow}</p>
        <h2 {...editableText("review.heading")} id="review-heading">{home.review.heading}</h2>
        <p {...editableText("review.introduction")}>
          {home.review.introduction}
        </p>
        <p {...editableText("review.description")}>
          {home.review.description}
        </p>
        <div class="review-placeholder image-placeholder">
          <span class="mini-browser review-audit-browser">
            <span class="mini-browser-bar" aria-hidden="true">
              <span class="mini-browser-dots"><i></i><i></i><i></i></span>
              <span {...editableText("work.display_domain")} class="mini-browser-address">{home.work.display_domain}</span>
            </span>
            <span class="mini-browser-screen review-audit-screen">
              <img {...editableImage("images.audit", "alt")}
                src={home.images.audit.image}
                alt={home.images.audit.alt}
                width={home.images.audit.width}
                height={home.images.audit.height}
                loading="lazy"
                decoding="async"
              />
            </span>
          </span>
        </div>
      </div>
      <div class="review-card">
        <form
          class="review-form"
          id="review-request-form"
          action="/?review=sent#review"
          method="post"
          data-review-request-form
        >
          <div class="review-fields">
            <div class="review-field">
              <label {...editableText("review.name_label")} for="review-name">{home.review.name_label}</label>
              <input
                id="review-name"
                name="name"
                type="text"
                autocomplete="name"
                placeholder={home.review.name_placeholder}
                required
              />
            </div>
            <div class="review-field">
              <label {...editableText("review.email_label")} for="review-email">{home.review.email_label}</label>
              <input
                id="review-email"
                name="email"
                type="email"
                inputmode="email"
                autocomplete="email"
                placeholder={home.review.email_placeholder}
                required
              />
            </div>
            <div class="review-field review-field-wide">
              <label {...editableText("review.website_label")} for="website">{home.review.website_label}</label>
              <input
                id="website"
                name="website"
                type="text"
                inputmode="url"
                autocomplete="url"
                autocapitalize="none"
                spellcheck="false"
                placeholder={home.review.website_placeholder}
                required
              />
            </div>
            <div class="review-field review-field-wide">
              <label {...editableText("review.help_label")} for="review-help">{home.review.help_label}</label>
              <textarea
                id="review-help"
                name="help_needed"
                rows="5"
                placeholder={home.review.help_placeholder}
              ></textarea>
              <p {...editableText("review.form_note")} class="form-note review-form-note">{home.review.form_note}</p>
            </div>
          </div>
          <input type="hidden" name="inbox_key" value="potential-client-contact" />
          <input type="hidden" name="_replyto" value="" data-review-replyto />
          <input type="hidden" name="_subject" value="Free website review request" />
          <input class="form-honeypot" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
          <p {...editableText("review.security_error")} class="form-error" role="alert" data-review-recaptcha-error hidden>
            {home.review.security_error}
          </p>
          <div class="review-submit-row">
            <div
              class="recaptcha-field"
              data-recaptcha-container
              data-recaptcha-site-key={recaptchaSiteKey}
              aria-label="Security check"
            ></div>
            <button class="button button-dark" type="submit" data-review-submit>
              <span {...editableText("review.submit_text")} data-review-submit-label>{home.review.submit_text}</span> <span aria-hidden="true">↗</span>
            </button>
          </div>
          <p {...editableText("review.submit_error")} class="form-error" role="alert" data-review-error hidden>
            {home.review.submit_error}
          </p>
        </form>

        <section
          class="review-success"
          data-review-success
          aria-labelledby="review-success-heading"
          tabindex="-1"
          hidden
        >
          <div class="success-mark" aria-hidden="true">✓</div>
          <p {...editableText("review.success_eyebrow")} class="success-kicker">{home.review.success_eyebrow}</p>
          <h3 {...editableText("review.success_heading")} id="review-success-heading">{home.review.success_heading}</h3>
          <p>
            <editable-text data-prop={homepageProp("review.success_message")} data-type="span">{home.review.success_message}</editable-text>
            <strong data-review-email>your inbox</strong>.
          </p>

          <div class="phone-step" data-phone-step>
            <p {...editableText("review.phone_eyebrow")} class="phone-step-label">{home.review.phone_eyebrow}</p>
            <h4 {...editableText("review.phone_heading")}>{home.review.phone_heading}</h4>
            <p {...editableText("review.phone_description")}>{home.review.phone_description}</p>
            <form
              class="phone-form"
              action="/?review=sent&amp;phone=added#review"
              method="post"
              data-phone-form
            >
              <input type="hidden" name="name" value="" data-phone-name />
              <input type="hidden" name="email" value="" data-phone-email />
              <input type="hidden" name="website" value="" data-phone-website />
              <input type="hidden" name="help_needed" value="" data-phone-help />
              <input type="hidden" name="inbox_key" value="potential-client-contact" />
              <input type="hidden" name="_subject" value="Phone number added to website review request" />
              <input class="form-honeypot" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
              <div
                class="recaptcha-field"
                data-recaptcha-container
                data-recaptcha-site-key={recaptchaSiteKey}
                aria-label="Security check"
              ></div>
              <p {...editableText("review.phone_security_error")} class="form-error" role="alert" data-phone-recaptcha-error hidden>
                {home.review.phone_security_error}
              </p>
              <label {...editableText("review.phone_label")} for="review-phone">{home.review.phone_label}</label>
              <div class="input-row phone-input-row">
                <input
                  id="review-phone"
                  name="phone"
                  type="tel"
                  inputmode="tel"
                  autocomplete="tel"
                  placeholder={home.review.phone_placeholder}
                  required
                />
                <button class="button button-dark" type="submit" data-phone-submit>
                  <span {...editableText("review.phone_submit_text")} data-phone-submit-label>{home.review.phone_submit_text}</span> <span aria-hidden="true">↗</span>
                </button>
              </div>
              <p {...editableText("review.phone_error")} class="form-error" role="alert" data-phone-error hidden>
                {home.review.phone_error}
              </p>
            </form>
          </div>
          <p class="phone-confirmation" data-phone-confirmation role="status" hidden>
            <span aria-hidden="true">✓</span> <editable-text data-prop={homepageProp("review.phone_confirmation")} data-type="span">{home.review.phone_confirmation}</editable-text>
          </p>
        </section>
      </div>
    </div>
  </section>

  </div>

  {recaptchaSiteKey && (
    <script src="https://www.google.com/recaptcha/api.js?render=explicit" async defer></script>
  )}

  <script>
    const previewButtons = document.querySelectorAll<HTMLButtonElement>("[data-preview-choice]");
    const previewDevices = document.querySelectorAll<HTMLElement>("[data-project-preview]");

    const setPreview = (view: string) => {
      previewButtons.forEach((button) => {
        const isActive = button.dataset.previewChoice === view;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-pressed", String(isActive));
      });
      previewDevices.forEach((device) => {
        device.classList.toggle("is-active", device.dataset.projectPreview === view);
      });
    };

    previewButtons.forEach((button) => {
      button.addEventListener("click", (event) => {
        if (event.defaultPrevented) return; // CloudCannon is editing the button label.
        setPreview(button.dataset.previewChoice || "desktop");
      });
    });

    const projectDialog = document.querySelector<HTMLDialogElement>("#energy-project-dialog");
    const dialogButtons = document.querySelectorAll<HTMLButtonElement>("[data-dialog-choice]");
    const dialogDesigns = document.querySelectorAll<HTMLElement>("[data-dialog-design]");

    const setDialogDesign = (view: string) => {
      dialogButtons.forEach((button) => {
        const isActive = button.dataset.dialogChoice === view;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-pressed", String(isActive));
      });
      dialogDesigns.forEach((design) => {
        design.classList.toggle("is-active", design.dataset.dialogDesign === view);
      });
      projectDialog?.querySelector(".project-dialog-scroll")?.scrollTo({ top: 0 });
    };

    document.querySelectorAll<HTMLButtonElement>("[data-open-project]").forEach((button) => {
      button.addEventListener("click", (event) => {
        if (event.defaultPrevented) return; // CloudCannon is editing the image or label.
        const activePreview = document.querySelector<HTMLButtonElement>("[data-preview-choice].is-active");
        setDialogDesign(button.dataset.projectView || activePreview?.dataset.previewChoice || "desktop");
        projectDialog?.showModal();
        document.body.classList.add("dialog-open");
      });
    });

    dialogButtons.forEach((button) => {
      button.addEventListener("click", (event) => {
        if (event.defaultPrevented) return;
        setDialogDesign(button.dataset.dialogChoice || "desktop");
      });
    });

    document.querySelector<HTMLButtonElement>("[data-close-project]")?.addEventListener("click", () => {
      projectDialog?.close();
    });

    projectDialog?.addEventListener("click", (event) => {
      if (event.target === projectDialog) projectDialog.close();
    });

    projectDialog?.addEventListener("close", () => document.body.classList.remove("dialog-open"));

    type ReviewContact = {
      name: string;
      email: string;
      website: string;
      helpNeeded: string;
    };

    const reviewForm = document.querySelector<HTMLFormElement>("[data-review-request-form]");
    const websiteInput = reviewForm?.querySelector<HTMLInputElement>("[name='website']");

    const normalizeWebsite = () => {
      if (!websiteInput) return false;
      const value = websiteInput.value.trim();
      const address = /^https?:\/\//i.test(value) ? value : `https://${value.replace(/^\/\//, "")}`;

      try {
        const url = new URL(address);
        if (
          !value || /\s/.test(value) ||
          !["http:", "https:"].includes(url.protocol) ||
          !url.hostname.includes(".") || url.username || url.password
        ) throw new Error("Invalid website address");
        websiteInput.setCustomValidity("");
        websiteInput.value = address;
        return true;
      } catch {
        websiteInput.setCustomValidity("Enter a website address like example.com.");
        websiteInput.reportValidity();
        return false;
      }
    };

    websiteInput?.addEventListener("input", () => websiteInput.setCustomValidity(""));
    const reviewSuccess = document.querySelector<HTMLElement>("[data-review-success]");
    const reviewEmail = document.querySelector<HTMLElement>("[data-review-email]");
    const reviewError = document.querySelector<HTMLElement>("[data-review-error]");
    const reviewSubmit = document.querySelector<HTMLButtonElement>("[data-review-submit]");
    const reviewSubmitLabel = document.querySelector<HTMLElement>("[data-review-submit-label]");
    const reviewSubmitText = reviewSubmitLabel?.textContent || "Get my free review";
    const reviewReplyTo = document.querySelector<HTMLInputElement>("[data-review-replyto]");
    const phoneForm = document.querySelector<HTMLFormElement>("[data-phone-form]");
    const phoneStep = document.querySelector<HTMLElement>("[data-phone-step]");
    const phoneConfirmation = document.querySelector<HTMLElement>("[data-phone-confirmation]");
    const phoneError = document.querySelector<HTMLElement>("[data-phone-error]");
    const phoneSubmit = document.querySelector<HTMLButtonElement>("[data-phone-submit]");
    const phoneSubmitLabel = document.querySelector<HTMLElement>("[data-phone-submit-label]");
    const phoneSubmitText = phoneSubmitLabel?.textContent || "Add my number";
    const reviewRecaptchaError = document.querySelector<HTMLElement>("[data-review-recaptcha-error]");
    const phoneRecaptchaError = document.querySelector<HTMLElement>("[data-phone-recaptcha-error]");
    const recaptchaContainers = document.querySelectorAll<HTMLElement>("[data-recaptcha-container]");

    type Recaptcha = {
      render: (container: HTMLElement, options: { sitekey: string; theme: "light" | "dark" }) => number;
    };

    const getRecaptcha = () => (window as Window & { grecaptcha?: Recaptcha }).grecaptcha;

    const renderRecaptcha = (container?: HTMLElement | null) => {
      if (!container || container.dataset.recaptchaWidgetId) return;
      const siteKey = container.dataset.recaptchaSiteKey;
      const recaptcha = getRecaptcha();
      if (!siteKey || !recaptcha) return;
      container.dataset.recaptchaWidgetId = String(
        recaptcha.render(container, { sitekey: siteKey, theme: "light" }),
      );
    };

    const renderVisibleRecaptcha = () => {
      recaptchaContainers.forEach((container) => {
        if (!container.closest("[hidden]")) renderRecaptcha(container);
      });
    };

    window.addEventListener("load", renderVisibleRecaptcha);

    const hasRecaptchaResponse = (form: HTMLFormElement) =>
      Boolean(form.querySelector<HTMLTextAreaElement>("textarea[name='g-recaptcha-response']")?.value);

    const setPhoneContext = (contact: ReviewContact) => {
      const phoneName = document.querySelector<HTMLInputElement>("[data-phone-name]");
      const phoneEmail = document.querySelector<HTMLInputElement>("[data-phone-email]");
      const phoneWebsite = document.querySelector<HTMLInputElement>("[data-phone-website]");
      const phoneHelp = document.querySelector<HTMLInputElement>("[data-phone-help]");

      if (phoneName) phoneName.value = contact.name;
      if (phoneEmail) phoneEmail.value = contact.email;
      if (phoneWebsite) phoneWebsite.value = contact.website;
      if (phoneHelp) phoneHelp.value = contact.helpNeeded || "";
      if (reviewEmail && contact.email) reviewEmail.textContent = contact.email;
    };

    const showReviewSuccess = (contact?: ReviewContact, shouldFocus = true) => {
      if (contact) setPhoneContext(contact);
      if (reviewForm) reviewForm.hidden = true;
      if (reviewSuccess) {
        reviewSuccess.hidden = false;
        renderVisibleRecaptcha();
        if (shouldFocus) reviewSuccess.focus();
      }
    };

    const encodeForm = (form: HTMLFormElement) => {
      const params = new URLSearchParams();
      new FormData(form).forEach((value, key) => {
        if (typeof value === "string") params.append(key, value);
      });
      return params.toString();
    };

    const postForm = async (form: HTMLFormElement) => {
      const response = await fetch(form.action, {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: encodeForm(form),
      });

      if (!response.ok) throw new Error("Form submission failed");
    };

    reviewForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      reviewError?.setAttribute("hidden", "");
      reviewRecaptchaError?.setAttribute("hidden", "");

      if (!normalizeWebsite()) return;

      if (!hasRecaptchaResponse(reviewForm)) {
        reviewRecaptchaError?.removeAttribute("hidden");
        return;
      }

      const formData = new FormData(reviewForm);
      const contact: ReviewContact = {
        name: String(formData.get("name") || ""),
        email: String(formData.get("email") || ""),
        website: String(formData.get("website") || ""),
        helpNeeded: String(formData.get("help_needed") || ""),
      };

      if (reviewReplyTo) reviewReplyTo.value = contact.email;
      reviewSubmit?.setAttribute("disabled", "");
      if (reviewSubmitLabel) reviewSubmitLabel.textContent = "Sending…";

      try {
        try {
          sessionStorage.setItem("reviewContact", JSON.stringify(contact));
        } catch {
          // The submission still works when browser storage is unavailable.
        }
        await postForm(reviewForm);
        showReviewSuccess(contact);
      } catch {
        reviewError?.removeAttribute("hidden");
      } finally {
        reviewSubmit?.removeAttribute("disabled");
        if (reviewSubmitLabel) reviewSubmitLabel.textContent = reviewSubmitText;
      }
    });

    phoneForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      phoneError?.setAttribute("hidden", "");
      phoneRecaptchaError?.setAttribute("hidden", "");

      if (!hasRecaptchaResponse(phoneForm)) {
        phoneRecaptchaError?.removeAttribute("hidden");
        return;
      }
      phoneSubmit?.setAttribute("disabled", "");
      if (phoneSubmitLabel) phoneSubmitLabel.textContent = "Adding…";

      try {
        await postForm(phoneForm);
        if (phoneStep) phoneStep.hidden = true;
        phoneConfirmation?.removeAttribute("hidden");
      } catch {
        phoneError?.removeAttribute("hidden");
      } finally {
        phoneSubmit?.removeAttribute("disabled");
        if (phoneSubmitLabel) phoneSubmitLabel.textContent = phoneSubmitText;
      }
    });

    const query = new URLSearchParams(window.location.search);
    if (query.get("review") === "sent") {
      let savedContact: ReviewContact | undefined;
      try {
        const rawContact = sessionStorage.getItem("reviewContact");
        if (rawContact) savedContact = JSON.parse(rawContact) as ReviewContact;
      } catch {
        savedContact = undefined;
      }

      showReviewSuccess(savedContact, false);
      if (query.get("phone") === "added") {
        if (phoneStep) phoneStep.hidden = true;
        phoneConfirmation?.removeAttribute("hidden");
      }
    }
  </script>
</Layout>
