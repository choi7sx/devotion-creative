---
import "../styles/main.css";
import site from "../../data/site.json";
import Header from "../components/navigation/header.astro";
import Footer from "../components/navigation/footer.astro";
import { SEO } from "astro-seo";

export interface SEOProps {
  page_description: string | null;
  featured_image: string | null;
  featured_image_alt: string | null;
  canonical_url: string | null;
  no_index: boolean | null;
  open_graph_type: string | null;
  author_twitter_handle: string | null;
}

export interface Props {
  title: string;
  seo?: SEOProps;
}

const { seo, title } = Astro.props;
const baseUrl = Astro.site?.toString();

let pageTitle = "";
if (!title) {
  pageTitle = site.site_title;
} else if (Astro.url.pathname === "/") {
  pageTitle = title;
} else {
  pageTitle = `${title} | ${site.site_title}`;
}

const description = seo?.page_description ?? site.description;
const image = seo?.featured_image ?? site.image;
const imagePath = image && baseUrl ? new URL(image, baseUrl).toString() : null;
const imageAlt = seo?.featured_image_alt ?? site.image_alt;
const canonicalURL = baseUrl
  ? new URL(seo?.canonical_url ?? Astro.url.pathname, baseUrl)
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Manrope:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />

    <SEO
      noindex={seo?.no_index || false}
      title={pageTitle}
      description={description}
      canonical={canonicalURL?.toString()}
      openGraph={imagePath ? {
          basic: {
            title: pageTitle,
            url: baseUrl,
            type: seo?.open_graph_type || "website",
            image: imagePath,
          },
          optional: { description },
          image: { url: imagePath, alt: imageAlt || "" },
        } : undefined}
      twitter={{
        creator: `${seo?.author_twitter_handle || site.twitter_site}`,
        site: `${site.twitter_site}`,
        card: "summary_large_image",
      }}
    />
  </head>
  <body id="top">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
