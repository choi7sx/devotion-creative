---
import home from "../../data/homepage.json";
import { editableText, editableImage } from "../utils/homepage-editing";

interface Props {
  interactive?: boolean;
  priority?: boolean;
}
const { interactive = false, priority = false } = Astro.props;
---

<div class:list={["project-stage", { "static-project-preview": !interactive }]} role="group" aria-label="Energy Transport desktop and mobile designs">
          <div class:list={["browser-frame", { "project-device is-active": interactive }]} data-project-preview={interactive ? "desktop" : undefined}>
            <div class="browser-bar" aria-hidden="true">
              <span class="browser-dots"><i></i><i></i><i></i></span>
              <span {...editableText("work.display_domain")} class="browser-address">{home.work.display_domain}</span>
            </div>
            <div class="browser-viewport">
              <img {...editableImage("images.desktop", "alt")}
                src={home.images.desktop.image}
                alt={home.images.desktop.alt}
                width={home.images.desktop.width}
                height={home.images.desktop.height}
                loading={priority ? "eager" : "lazy"}
                fetchpriority={priority ? "high" : "auto"}
                decoding="async"
              />
            </div>
          </div>

          <div class:list={["phone-frame", { "project-device": interactive }]} data-project-preview={interactive ? "mobile" : undefined}>
            <div class="phone-speaker" aria-hidden="true"></div>
            <div class="phone-viewport">
              <img {...editableImage("images.mobile", "alt")}
                src={home.images.mobile.image}
                alt={home.images.mobile.alt}
                width={home.images.mobile.width}
                height={home.images.mobile.height}
                loading={priority ? "eager" : "lazy"}
                fetchpriority={priority ? "high" : "auto"}
                decoding="async"
              />
            </div>
          </div>
        </div>

<style>
  /* Keep the homepage composition together on small case-study screens. */
  @media (max-width: 680px) {
    .static-project-preview {
      display: block;
      min-height: 0;
      aspect-ratio: 3 / 2;
      padding: 6%;
      container-type: inline-size;
    }
    .static-project-preview .browser-frame { width: 88%; border-radius: 0.3rem; }
    .static-project-preview .browser-viewport { aspect-ratio: 16 / 9; }
    .static-project-preview .browser-bar { min-height: 3.2cqw; padding-inline: 1.2cqw; }
    .static-project-preview .browser-dots { gap: 0.5cqw; }
    .static-project-preview .browser-dots i { width: 0.7cqw; height: 0.7cqw; }
    .static-project-preview .browser-address { padding: 0.25cqw 1cqw; font-size: 1cqw; }
    .static-project-preview .phone-frame {
      position: absolute;
      right: 5%;
      bottom: 7%;
      width: 22%;
      padding: 0.7cqw;
      border-radius: 2.2cqw;
    }
    .static-project-preview .phone-viewport { border-radius: 1.5cqw; }
    .static-project-preview .phone-speaker { top: 1cqw; height: 0.35cqw; }
  }
</style>
