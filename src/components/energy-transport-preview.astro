---
import home from "../../data/homepage.json";
import ProjectPreview from "./project-preview.astro";

interface Props {
  priority?: boolean;
}
const { priority = false } = Astro.props;
---

<ProjectPreview
  name={home.work.project_name}
  domain={home.work.display_domain}
  images={home.images}
  imagesKey="images"
  domainKey="work.display_domain"
  desktopCropHeight={1158}
  priority={priority}
/>
