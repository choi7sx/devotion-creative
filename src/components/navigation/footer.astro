---
import home from "../../../data/homepage.json";
import { editableText, homepageProp } from "../../utils/homepage-editing";
---

<footer class="site-footer">
  <div class="shell footer-top">
    <div>
      <a class="wordmark wordmark-light" href={home.brand.home_link} aria-label={`${home.brand.first_line} ${home.brand.second_line} home`}>
        <span class="wordmark-mark" aria-hidden="true"></span>
        <span><editable-text data-prop={homepageProp("brand.first_line")} data-type="span">{home.brand.first_line}</editable-text><br /><editable-text data-prop={homepageProp("brand.second_line")} data-type="span">{home.brand.second_line}</editable-text></span>
      </a>
      <p {...editableText("footer.description")}>{home.footer.description}</p>
    </div>
    <div class="footer-contact">
      <a href={home.header.review_link}><editable-text data-prop={homepageProp("hero.button_text")} data-type="span">{home.hero.button_text}</editable-text> ↗</a>
      {home.footer.email.trim() && <p {...editableText("footer.email")}>{home.footer.email}</p>}
      {home.footer.phone.trim() && <p {...editableText("footer.phone")}>{home.footer.phone}</p>}
      {home.footer.location.trim() && <p {...editableText("footer.location")}>{home.footer.location}</p>}
    </div>
  </div>
  <div class="shell footer-bottom">
    <p>© {new Date().getFullYear()} <editable-text data-prop={homepageProp("brand.copyright_name")} data-type="span">{home.brand.copyright_name}</editable-text></p>
    <a {...editableText("footer.back_text")} href={home.footer.back_link}>{home.footer.back_text}</a>
  </div>
</footer>
