---
import home from "../../../data/homepage.json";
import { editableText, homepageProp } from "../../utils/homepage-editing";
---

<header class="site-header">
  <div class="shell">
    <nav class="site-nav" aria-label="Primary navigation">
      <a class="wordmark" href={home.brand.home_link} aria-label={`${home.brand.first_line} ${home.brand.second_line} home`}>
        <span class="wordmark-mark" aria-hidden="true"></span>
        <span><editable-text data-prop={homepageProp("brand.first_line")} data-type="span">{home.brand.first_line}</editable-text><br /><editable-text data-prop={homepageProp("brand.second_line")} data-type="span">{home.brand.second_line}</editable-text></span>
      </a>

      <ul class="nav-links">
        <li><a {...editableText("header.services_text")} href={home.header.services_link}>{home.header.services_text}</a></li>
        <li><a {...editableText("header.work_text")} href={home.header.work_link}>{home.header.work_text}</a></li>
        <li><a {...editableText("header.about_text")} href={home.header.about_link}>{home.header.about_text}</a></li>
      </ul>

      <a class="nav-cta" href={home.header.review_link}><editable-text data-prop={homepageProp("header.review_text")} data-type="span">{home.header.review_text}</editable-text> <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
